{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tsutawatari",
  "compatibility_date": "2026-10-06",
  // game.chozo.net の他のゲームと同じく、パス配下だけで公開する
  "workers_dev": false,
  "preview_urls": false,
  // 静的アセットだけを配信（Worker スクリプトなし）。
  // URL の /tsutawatari/ に合わせ、dist/tsutawatari/ に出力している
  "assets": { "directory": "./dist" },
  "routes": [
    { "pattern": "game.chozo.net/tsutawatari*", "zone_name": "chozo.net" }
  ]
}
